# ─── Βάση Δεδομένων ───────────────────────────────────────────────
# SQLite (default - αρχείο τοπικά)
DATABASE_URL=sqlite:///./gym.db

# PostgreSQL (για αναβάθμιση αργότερα - απλώς αλλάζεις αυτή τη γραμμή)
# DATABASE_URL=postgresql://user:password@localhost:5432/gymdb

# ─── Email Provider ───────────────────────────────────────────────
# Επιλογή: "gmail" ή "sendgrid"
EMAIL_PROVIDER=gmail

# Στοιχεία Γυμναστηρίου
GYM_NAME=GymPro
GYM_EMAIL=info@gymname.gr
GYM_PHONE=210-1234567
GYM_ADDRESS=Ερμού 10, Αθήνα
GYM_HOURS=07:00 - 23:00

# ─── Gmail SMTP ───────────────────────────────────────────────────
# Χρειάζεσαι "App Password" από Google (όχι τον κανονικό κωδικό σου)
# Οδηγίες: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ─── SendGrid ─────────────────────────────────────────────────────
# Δωρεάν έως 100 emails/ημέρα
# Οδηγίες: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Anthropic API (για AI email generation) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── App Settings ─────────────────────────────────────────────────
SECRET_KEY=αλλαξε_αυτο_με_κατι_τυχαιο_και_μεγαλο_123456
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
